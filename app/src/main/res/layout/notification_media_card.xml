<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏磨砂媒体卡片（网易云风格）：封面模糊背景 + 遮罩 + 圆角封面/歌名/歌手 + 三键遥控。
     颜色引用 @color/noti_card_*，values / values-night 两套，深浅形态随系统夜间模式自动切换。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 磨砂背景：封面重度模糊铺满（无封面时仅剩遮罩底色） -->
    <ImageView
        android:id="@+id/iv_blur_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- 磨砂遮罩：浅色白纱 / 深色墨纱（RemoteViews 白名单不支持裸 View，用 FrameLayout 承载背景色） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/noti_card_mask" />

    <LinearLayout
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/noti_card_title" />

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/noti_card_artist" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_noti_prev"
            android:tint="@color/noti_btn_tint"
            android:contentDescription="@string/s1d9c70" />

        <ImageButton
            android:id="@+id/btn_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_noti_play"
            android:tint="@color/noti_btn_tint"
            android:contentDescription="@string/sb85270" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_noti_next"
            android:tint="@color/noti_btn_tint"
            android:contentDescription="@string/scfd960" />
    </LinearLayout>
</FrameLayout>
